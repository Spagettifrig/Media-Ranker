# Cloudflare Pages (and Netlify) response headers for the website.

# The app shell and service worker must be re-checked on every visit, or a
# phone keeps running an old version long after a deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Build files carry a content hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
